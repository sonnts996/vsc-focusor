{
  "name": "focusor",
  "displayName": "Focusor",
  "description": "Focus on what changed — filter and view git changes across your workspace repos",
  "version": "0.1.0",
  "publisher": "sonnts996",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "scm",
    "focus",
    "multi-root",
    "filter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sonnts996/vsc-focusor"
  },
  "license": "MIT",
  "icon": "resources/focusor-icon.png",
  "activationEvents": [
    "workspaceContains:**/.git"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "Focusor: General",
        "properties": {
          "focusor.general.showSeparator": {
            "type": "boolean",
            "default": true,
            "description": "Show a visual separator line between repositories in the tree view."
          },
          "focusor.general.separatorLength": {
            "type": "number",
            "default": 10,
            "description": "The number of characters (length) of the separator line."
          },
          "focusor.general.autoRefreshOnVisible": {
            "type": "boolean",
            "default": true,
            "description": "Automatically refresh the changes when the Focusor panel becomes visible."
          },
          "focusor.general.displayMode": {
            "type": "string",
            "enum": [
              "gitOnly",
              "recentOnly",
              "combined",
              "separate"
            ],
            "default": "combined",
            "description": "How to display the recent files view."
          }
        }
      },
      {
        "title": "Focusor: Changes View",
        "properties": {
          "focusor.changes.splitStaged": {
            "type": "boolean",
            "default": true,
            "description": "Split changes into 'Staged Changes' and 'Changes' groups."
          },
          "focusor.changes.viewMode": {
            "type": "string",
            "enum": [
              "list",
              "tree",
              "compact"
            ],
            "default": "tree",
            "description": "How to display directories in the Git changes view. 'list' shows a flat list of files. 'tree' shows nested directories. 'compact' shows nested directories but compacts single-child folders."
          }
        }
      },
      {
        "title": "Focusor: Recent Files",
        "properties": {
          "focusor.recents.maxFiles": {
            "type": "number",
            "default": 50,
            "description": "Maximum number of files to keep in the recent list."
          },
          "focusor.recents.groupByRepo": {
            "type": "boolean",
            "default": false,
            "description": "Group recent files by repository."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "focusor",
          "title": "Focusor",
          "icon": "resources/focusor-icon.svg"
        },
        {
          "id": "focusor-git-only",
          "title": "Git Changes",
          "icon": "resources/focusor-icon-git-changes.svg"
        },
        {
          "id": "focusor-recents-container",
          "title": "Recent Files",
          "icon": "resources/focusor-icon-recents.svg"
        }
      ]
    },
    "views": {
      "focusor": [
        {
          "id": "focusor-changes",
          "name": "Changes",
          "when": "config.focusor.general.displayMode == 'combined'"
        },
        {
          "id": "focusor-recents",
          "name": "Recents",
          "when": "config.focusor.general.displayMode == 'combined'"
        }
      ],
      "focusor-git-only": [
        {
          "id": "focusor-changes-git-only",
          "name": "Changes",
          "when": "config.focusor.general.displayMode == 'gitOnly' || config.focusor.general.displayMode == 'separate'"
        }
      ],
      "focusor-recents-container": [
        {
          "id": "focusor-recents-separate",
          "name": "Recents",
          "when": "config.focusor.general.displayMode == 'separate' || config.focusor.general.displayMode == 'recentOnly'"
        }
      ]
    },
    "commands": [
      {
        "command": "focusor.refresh",
        "title": "Refresh",
        "category": "Focusor",
        "icon": "$(refresh)"
      },
      {
        "command": "focusor.expandAll",
        "title": "Expand All",
        "category": "Focusor",
        "icon": "$(expand-all)"
      },
      {
        "command": "focusor.collapseAll",
        "title": "Collapse All",
        "category": "Focusor",
        "icon": "$(collapse-all)"
      },
      {
        "command": "focusor.toggleViewMode",
        "title": "Toggle View Mode (List/Tree)",
        "category": "Focusor",
        "icon": "$(list-tree)"
      },
      {
        "command": "focusor.filterRepos",
        "title": "Filter Repositories...",
        "category": "Focusor",
        "icon": "$(filter)"
      },
      {
        "command": "focusor.openFile",
        "title": "Open File",
        "category": "Focusor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "focusor.openDiff",
        "title": "Open Changes",
        "category": "Focusor",
        "icon": "$(diff)"
      },
      {
        "command": "focusor.openInSCM",
        "title": "Open in Source Control",
        "category": "Focusor",
        "icon": "$(source-control)"
      },
      {
        "command": "focusor.openInExplorer",
        "title": "Reveal in File Explorer",
        "category": "Focusor",
        "icon": "$(folder)"
      },
      {
        "command": "focusor.copyPath",
        "title": "Copy Path",
        "category": "Focusor"
      },
      {
        "command": "focusor.copyRelativePath",
        "title": "Copy Relative Path",
        "category": "Focusor"
      },
      {
        "command": "focusor.stageFile",
        "title": "Stage Changes",
        "category": "Focusor",
        "icon": "$(add)"
      },
      {
        "command": "focusor.unstageFile",
        "title": "Unstage Changes",
        "category": "Focusor",
        "icon": "$(remove)"
      },
      {
        "command": "focusor.discardFile",
        "title": "Discard Changes",
        "category": "Focusor",
        "icon": "$(discard)"
      },
      {
        "command": "focusor.stageAll",
        "title": "Stage All Changes",
        "category": "Focusor",
        "icon": "$(add)"
      },
      {
        "command": "focusor.unstageAll",
        "title": "Unstage All Changes",
        "category": "Focusor",
        "icon": "$(remove)"
      },
      {
        "command": "focusor.discardAll",
        "title": "Discard All Changes",
        "category": "Focusor",
        "icon": "$(discard)"
      },
      {
        "command": "focusor.recents.pin",
        "title": "Pin",
        "category": "Focusor",
        "icon": "$(pin)"
      },
      {
        "command": "focusor.recents.unpin",
        "title": "Unpin",
        "category": "Focusor",
        "icon": "$(pinned)"
      },
      {
        "command": "focusor.recents.clear",
        "title": "Clear All",
        "category": "Focusor",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "focusor.refresh",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only')",
          "group": "navigation@1"
        },
        {
          "command": "focusor.expandAll",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && !focusor.isExpanded",
          "group": "navigation@2"
        },
        {
          "command": "focusor.collapseAll",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && focusor.isExpanded",
          "group": "navigation@2"
        },
        {
          "command": "focusor.toggleViewMode",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only')",
          "group": "navigation@3"
        },
        {
          "command": "focusor.filterRepos",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only')",
          "group": "navigation@4"
        },
        {
          "command": "focusor.recents.clear",
          "when": "view == focusor-recents || view == focusor-recents-separate",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "focusor.openFile",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && (viewItem == stagedFile || viewItem == unstagedFile || viewItem == file)",
          "group": "inline@1"
        },
        {
          "command": "focusor.stageFile",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && (viewItem == unstagedFile || viewItem == unstagedFolder)",
          "group": "inline@3"
        },
        {
          "command": "focusor.unstageFile",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && (viewItem == stagedFile || viewItem == stagedFolder)",
          "group": "inline@3"
        },
        {
          "command": "focusor.discardFile",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && (viewItem == unstagedFile || viewItem == unstagedFolder)",
          "group": "inline@4"
        },
        {
          "command": "focusor.stageAll",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && viewItem == unstagedGroup",
          "group": "inline@1"
        },
        {
          "command": "focusor.unstageAll",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && viewItem == stagedGroup",
          "group": "inline@1"
        },
        {
          "command": "focusor.discardAll",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && viewItem == unstagedGroup",
          "group": "inline@2"
        },
        {
          "command": "focusor.openInSCM",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only')",
          "group": "7_modification@1"
        },
        {
          "command": "focusor.stageFile",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && (viewItem == unstagedFile || viewItem == unstagedFolder)",
          "group": "7_modification@2"
        },
        {
          "command": "focusor.unstageFile",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && (viewItem == stagedFile || viewItem == stagedFolder)",
          "group": "7_modification@2"
        },
        {
          "command": "focusor.discardFile",
          "when": "(view == 'focusor-changes' || view == 'focusor-changes-git-only') && (viewItem == unstagedFile || viewItem == unstagedFolder)",
          "group": "7_modification@3"
        },
        {
          "command": "focusor.openInExplorer",
          "when": "viewItem =~ /file|folder|File|Folder|repo/",
          "group": "navigation@1"
        },
        {
          "command": "focusor.copyPath",
          "when": "viewItem =~ /file|folder|File|Folder/",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "focusor.copyRelativePath",
          "when": "viewItem =~ /file|folder|File|Folder/",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "focusor.recents.pin",
          "when": "(view == focusor-recents || view == focusor-recents-separate) && viewItem == recentFileUnpinned",
          "group": "inline@1"
        },
        {
          "command": "focusor.recents.unpin",
          "when": "(view == focusor-recents || view == focusor-recents-separate) && viewItem == recentFilePinned",
          "group": "inline@1"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "focusor-changes",
        "contents": "No changed repositories found in the workspace.\n[Refresh](command:focusor.refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}